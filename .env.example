# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never exposed to the browser

# Gemini Flash is accessed through OpenRouter (pinned to Google's own infrastructure)
OPENROUTER_API_KEY=sk-or-v1-...
GEMINI_MODEL=google/gemini-3.7-flash

# Any long random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=change-me

# Optional: if set, the dashboard asks for this password
DASHBOARD_PASSWORD=
