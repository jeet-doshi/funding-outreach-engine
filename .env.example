# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never exposed to the browser

# Google AI Studio → Get API key
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash

# Any long random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=change-me

# Optional: if set, the dashboard asks for this password
DASHBOARD_PASSWORD=
